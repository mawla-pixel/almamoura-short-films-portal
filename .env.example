# Bunny Stream settings. Keep BUNNY_API_KEY server-side; never use the VITE_ prefix.
BUNNY_API_KEY=your_bunny_stream_api_key
BUNNY_LIBRARY_ID=your_video_library_id
# Set this to the short films collection when the Bunny library contains multiple contest sections.
BUNNY_COLLECTION_ID=
BUNNY_PULL_ZONE=

# Optional: web server port (defaults to 8080).
PORT=8080
